{
  "name": "hujajj-hospital-api",
  "version": "1.1.0",
  "description": "Authenticated patient records API for Hujajj Hospital & Tech Hub (PostgreSQL-backed)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node -e \"require('dotenv').config(); const fs=require('fs'); const pool=require('./db'); pool.query(fs.readFileSync('./schema.sql','utf8')).then(()=>{console.log('Migration complete');process.exit(0);}).catch(e=>{console.error(e);process.exit(1);})\"",
    "create-admin": "node scripts/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
