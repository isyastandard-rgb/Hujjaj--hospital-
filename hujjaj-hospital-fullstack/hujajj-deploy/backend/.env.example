# Copy this file to .env and fill in your values.

# Connection string from your Postgres provider (Render, Railway, Supabase, Neon, RDS...)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "false" only for local/plain Postgres without SSL (e.g. Docker Compose below).
DATABASE_SSL=true

# Secret used to sign login sessions (JWTs). Must be random and at least
# 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# How long a login session stays valid before staff must sign in again.
JWT_EXPIRES_IN=12h

# Port the API server listens on.
PORT=4000

# development | production — affects logging verbosity.
NODE_ENV=development

# Restrict which origin(s) may call the API once you know your frontend's
# deployed URL, e.g. https://hujajj-hospital.netlify.app
CORS_ORIGIN=*
